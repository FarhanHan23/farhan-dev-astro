---
// src/components/Header.astro
---

<header class="header-container">
    <div class="avatar-wrapper">
        <img src="/Farhan_photo.png" alt="Farhan Akmal" class="avatar-img" />
    </div>

    <div class="info-wrapper">
        <h1 class="brand-title">FarhanAkmal.dev</h1>
        <p class="tech-stack">
            React <span>|</span> Frontend <span>|</span> Docker <span>|</span> Typescript
            <span>|</span> Golang
        </p>
    </div>
</header>

<style>
    .header-container {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    /* Secara default di Mobile: Foto disembunyikan */
    .avatar-wrapper {
        display: none;
        width: 78px;
        height: 78px;
        flex-shrink: 0;
        overflow: hidden;
    }

    .avatar-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .info-wrapper {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 6px;
    }

    .brand-title {
        font-size: 1.75rem; /* Ukuran font di mobile */
        font-weight: 700;
        color: #ffffff;
        margin: 0;
        line-height: 1.2;
    }

    .tech-stack {
        font-size: 0.9rem;
        color: #94a3b8;
        margin: 0;
        font-weight: 400;
    }

    .tech-stack span {
        color: #475569;
        margin: 0 4px;
    }

    /* Tampilan Desktop (Layar >= 768px): Tampilkan foto avatar */
    @media (min-width: 768px) {
        .avatar-wrapper {
            display: block;
        }

        .brand-title {
            font-size: 2rem;
        }

        .tech-stack {
            font-size: 1rem;
        }
    }
</style>
